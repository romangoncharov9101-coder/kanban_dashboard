POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=

LOG_LEVEL=
EVENT_CLEANUP_INTERVAL=
EVENT_MAX_AGE_SECONDS=

SESSION_SECRET_KEY=
SESSION_TTL_SECONDS=
SESSION_COOKIE_NAME=
EXPOSE_DOCS=False

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SYNC_PASSWORD_ON_START=
SESSION_COOKIE_SECURE=

LOG_DIR=
AUDIT_LOG_ENABLED=True
AUDIT_LOG_RETENTION_DAYS=
EVENT_DB_RETENTION_DAYS=

FRONTEND_HOST_PORT=

# Сессии
# Таймаут ПРОСТОЯ. Пока человек работает, срок сдвигается вперёд,
# поэтому это «сколько можно не заходить», а не «через сколько выкинет».
SESSION_TTL_SECONDS=
 
# Продлевать сессию при активности. false — вернётся старое поведение
# (фиксированный срок от момента входа).
SESSION_SLIDING_ENABLED=
 
# Не чаще одного UPDATE по таблице sessions в этот интервал.
SESSION_REFRESH_INTERVAL_SECONDS=
 
# Жёсткий потолок от момента входа. 0 — без потолка.
SESSION_ABSOLUTE_TTL_SECONDS=
 
# Обязательно постоянное значение! Если ключ меняется при каждом
# запуске сервиса, все cookie разом становятся недействительными
# и пользователей выбрасывает при любом рестарте бэкенда.
SESSION_SECRET_KEY=
 
# true, если фронт работает по HTTPS. При false и HTTPS часть браузеров
# может не сохранять cookie.
SESSION_COOKIE_SECURE=